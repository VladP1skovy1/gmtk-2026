  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- The company planned 20 rocket launches. You have to decide if the rocket
    launch should be aborted or not during the countdown. \r\n\r\n- The Rulebook
    Window contains all the instructions needed to decide if the rocket launch should
    be aborted, split into several tabs, and can be opened using the blue button.\r\n\r\n-
    Information about the rocket is displayed in the Rocket Info window, which can
    be opened using the green button. \r\n\u200B\r\n- Windows containing the information
    about weather, fuel tanks, engines, and crew could be opened using gray buttons.
    \r\n\r\n- To abort the launch, press the red button. If the launch isn\u2019t
    aborted during the countdown, the rocket will be launched.\r\n\r\n- The company
    will achieve its goal by successfully launching five rockets; however, the destruction
    of five rockets will certainly lead to bankruptcy. Aborted launches are not directly
    penalised, but the number of launches is limited, so choose wisely. \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 04a824208fddd7b479fbb3234c4b5350, type: 2}
  m_sharedMaterial: {fileID: 5629811222919996706, guid: 04a824208fddd7b479fbb3234c4b5350, type: 2}
