--- !u!114 &8700876439781039339
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 424988441562706216}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2749f5cd076a6749af82c7ecbea9523, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LaunchBad.Rules.RuleBook
  ruleTabs:
  - <TabName>k__BackingField: General
    <Rules>k__BackingField:
    - <Text>k__BackingField: This window contains all the instructions needed to
        decide if the rocket launch should be aborted, split into several tabs, and
        can be opened using the blue button.
      <LaunchNumber>k__BackingField: 0
    - <Text>k__BackingField: Some rockets have special instructions written in the
        Rocket Info Window. The general rules still apply, unless the special instructions
        specify otherwise.
      <LaunchNumber>k__BackingField: 8
  - <TabName>k__BackingField: Weather
    <Rules>k__BackingField:
    - <Text>k__BackingField: 'If the temperature reaches a value outside the range
        specified in the Rocket Info Window, the launch must be aborted immediately. '
      <LaunchNumber>k__BackingField: 0
    - <Text>k__BackingField: 'If the speed of the wind reaches the value above the
        maximum value specified in the Rocket Info, the launch must be aborted immediately. '
      <LaunchNumber>k__BackingField: 0
    - <Text>k__BackingField: 'Rockets could only be launched during clear or cloudy
        weather. If storm clouds could be seen in the Weather Window, the launch
        must be aborted. '
      <LaunchNumber>k__BackingField: 2
  - <TabName>k__BackingField: Fuel
    <Rules>k__BackingField:
    - <Text>k__BackingField: 'If the fuel level displayed in the Fuel Tank Window
        drops below the mark, the launch should be aborted immediately. '
      <LaunchNumber>k__BackingField: 3
  - <TabName>k__BackingField: Engine
    <Rules>k__BackingField:
    - <Text>k__BackingField: If the engine shown in the Engine Window is sparking
        or smoking, the launch should be aborted immediately.
      <LaunchNumber>k__BackingField: 4
    - <Text>k__BackingField: If the engine shown in the Engine Window does not ignite
        at the exact time specified in the Rocket Info, the launch should be aborted
        immediately.
      <LaunchNumber>k__BackingField: 4
  - <TabName>k__BackingField: Crew
    <Rules>k__BackingField:
    - <Text>k__BackingField: If more than half of the crew is depressed, with less
        than 10 seconds remaining, the launch should be aborted.
      <LaunchNumber>k__BackingField: 6
    - <Text>k__BackingField: 'If any crew member is sick, the launch should be aborted
        immediately. '
      <LaunchNumber>k__BackingField: 6
  ruleTabPrefab: {fileID: 686526884145140289, guid: f62dc8aa6f791a14cb802233efc1f15a, type: 3}
  ruleTabButtonPrefab: {fileID: 1444927334004548670, guid: f0e08457ae926504ab374317c1ef9d82, type: 3}
  ruleTextPrefab: {fileID: 391303682332591117, guid: 0d12fc23dd3dfa24f80dfef04f333114, type: 3}
